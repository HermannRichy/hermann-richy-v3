# ─── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://hermannrichy.dev
BETTER_AUTH_URL=https://hermannrichy.dev

# ─── Base de données (Neon PostgreSQL) ─────────────────────────────────
# URL poolée (application) et URL directe (migrations Prisma)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/portfolio?sslmode=verify-full
DIRECT_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/portfolio?sslmode=verify-full

# ─── Sécurité ──────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 16 (empreinte des IP pour la limitation de débit)
IP_HASH_SALT=

# ─── Admin ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=hermannrichy15@gmail.com
# Adresse secrète de connexion (8 à 64 caractères : lettres, chiffres, - et _)
# echo "studio-$(openssl rand -hex 6)"  →  https://hermannrichy.dev/studio-xxxxxxxxxxxx
ADMIN_PATH=

# ─── E-mails (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend (sinon onboarding@resend.dev, envoi vers votre propre adresse uniquement)
EMAIL_FROM=Hermann Richy <contact@hermannrichy.dev>
# Destinataire des messages de contact (par défaut ADMIN_EMAIL)
CONTACT_TO=

# ─── Images (Cloudinary) ───────────────────────────────────────────────
# console.cloudinary.com → Settings → API Keys (envoi signé direct navigateur → Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
